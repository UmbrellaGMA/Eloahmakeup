# =============================================================================
# Eloah Make Up — variáveis de ambiente
# Copie para .env.local e preencha. NUNCA versione o .env.local.
# Variáveis NEXT_PUBLIC_* vão para o navegador: não coloque segredos nelas.
# =============================================================================

# --- Supabase (Project Settings → API) ---------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente servidor. Ignora RLS — nunca exponha.
SUPABASE_SERVICE_ROLE_KEY=
# Somente para rodar migrations (npm run db:migrate). Project Settings → Database → Connection string (URI)
SUPABASE_DB_URL=

# --- Mercado Pago (Suas integrações → Credenciais de produção) ---------------
MERCADOPAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
# Suas integrações → Webhooks → Assinatura secreta
MERCADOPAGO_WEBHOOK_SECRET=

# --- SuperFrete (Integrações → Gerar token) ----------------------------------
SUPERFRETE_TOKEN=
# "production" ou "sandbox"
SUPERFRETE_ENV=production
# Segredo informado ao cadastrar o webhook app na SuperFrete
SUPERFRETE_WEBHOOK_SECRET=
# E-mail de contato técnico exigido no User-Agent pela SuperFrete
SUPERFRETE_CONTACT_EMAIL=

# --- Site ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Protege as rotas /api/cron/* (expiração de pedidos e rastreamento)
CRON_SECRET=

# E-mails transacionais (Resend — https://resend.com). Domínio eloahmakeup.com verificado no Resend.
RESEND_API_KEY=
EMAIL_FROM=Eloah Make Up <pedidos@eloahmakeup.com>
EMAIL_REPLY_TO=eloahmakeup43@gmail.com
# Recebe o aviso de nova venda
STORE_NOTIFY_EMAIL=eloahmakeup43@gmail.com

# Notificações push do app do painel (gere com: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://eloahmakeup.com
